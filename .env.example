# Copiar a .env (no se versiona) y cargarlo en la terminal antes de "npm run deploy".
# Contraseña maestra de RDS PostgreSQL: 8-41 caracteres, sin / @ " ni espacios.
DB_PASSWORD=cambiar_por_una_clave_segura
# Clave para firmar los JWT (HS256). Mínimo 32 caracteres aleatorios.
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
