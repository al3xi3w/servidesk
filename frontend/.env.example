# Copiar a .env.local. Si falta la URL de un servicio, ese servicio se simula en el navegador (src/mocks).
VITE_API_IDENTITY_URL=
VITE_API_CMDB_URL=
VITE_API_INCIDENTS_URL=
VITE_API_PROBLEMS_URL=
VITE_API_CHANGES_URL=
VITE_API_REQUESTS_URL=
# "true" fuerza el modo demo en todos los servicios aunque haya URLs.
VITE_USE_MOCKS=false
